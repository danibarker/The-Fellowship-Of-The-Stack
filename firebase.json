{
  "functions": {
    "source": "functions"
  },
  "emulators": {
    "functions": {
      "port": 6000
    },
    "hosting": {
      "port": 6001
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 6002
    }
  },
  "hosting": {
    "public": "frontend/build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
